{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "frontend",
  "functions": {
    "api/index.py": {
      "includeFiles": "backend/**",
      "maxDuration": 300
    }
  },
  "rewrites": [
    { "source": "/api/probe", "destination": "/api/probe" },
    { "source": "/api/:path*", "destination": "/api/index" }
  ]
}
