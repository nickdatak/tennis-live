# Copy to backend/.env and fill in. Never commit backend/.env.

# Supabase → Settings → Database → Connection string → Session pooler URI.
# Example shape:
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# RapidAPI key for "Tennis API - ATP WTA ITF" (used by the Refresh data button).
TENNIS_API_KEY=

# Refresh is DISABLED by default to preserve Tennis API quota; the dashboard
# button reports "refresh disabled to preserve quota". Set to 1 to re-enable.
REFRESH_ENABLED=

# Required on public deployments: POST /api/refresh only works with this value
# in the X-Refresh-Token header (the dashboard prompts for it once).
REFRESH_TOKEN=

# Set to 1 on the hosting platform: refuse to boot without DATABASE_URL.
PRODUCTION=

# Surface Elo for a surface the player never played on:
#   initial  = 1500, matches the research training semantics (default)
#   as_given = trust the value stored in the database / players.json
SURFACE_DEBUT_ELO_MODE=initial
